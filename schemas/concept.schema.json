{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept.schema.json",
  "title": "Annotated example action",
  "$defs": {
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "code"
      ],
      "properties": {
        "language": {
          "enum": [
            "php",
            "javascript",
            "json",
            "yaml",
            "shell",
            "text"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hint",
    "code",
    "parts"
  ],
  "properties": {
    "hint": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "$ref": "#/$defs/snippet"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "match",
          "title",
          "text"
        ],
        "properties": {
          "ref": {
            "type": "integer",
            "minimum": 1
          },
          "match": {
            "type": "string",
            "minLength": 1,
            "description": "Exact text in code that gets highlighted"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown (inline)"
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "columns",
              "rows"
            ],
            "description": "Optional table below the text, for example a mapping. Cells are Markdown (inline).",
            "properties": {
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
