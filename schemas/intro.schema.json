{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intro.schema.json",
  "title": "Hero: headline, example and key facts",
  "$defs": {
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "code"
      ],
      "properties": {
        "language": {
          "enum": [
            "php",
            "javascript",
            "json",
            "yaml",
            "shell",
            "text"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "headline_accent",
    "lead",
    "target_version",
    "code",
    "channels",
    "facts"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "headline_accent": {
      "type": "string",
      "minLength": 1
    },
    "lead": {
      "type": "string",
      "minLength": 1
    },
    "target_version": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "$ref": "#/$defs/snippet"
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "icon",
          "title",
          "text"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1,
            "description": "id of the entry in channels.json the tile links to"
          },
          "icon": {
            "type": "string",
            "maxLength": 4
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
