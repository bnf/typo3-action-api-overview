{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sections.schema.json",
  "title": "Ordered page sections; each id needs _includes/sections/<id>.html",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "lead"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "lead": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown (inline)"
      },
      "note": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown (inline)"
      }
    }
  }
}
