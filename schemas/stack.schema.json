{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stack.schema.json",
  "title": "Layers of the stack and playable request scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layers",
    "scenarios"
  ],
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "tagline",
          "items",
          "title",
          "body",
          "components"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "tagline": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "description": "Markdown"
          },
          "components": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layer",
                "item",
                "title",
                "body"
              ],
              "properties": {
                "layer": {
                  "type": "string",
                  "minLength": 1
                },
                "item": {
                  "type": "string",
                  "description": "Must be one of the items of the layer"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "description": "Markdown"
                }
              }
            }
          }
        }
      }
    }
  }
}
