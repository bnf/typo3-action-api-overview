{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "extend.schema.json",
  "title": "Guide for extension developers",
  "$defs": {
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "code"
      ],
      "properties": {
        "language": {
          "enum": [
            "php",
            "javascript",
            "json",
            "yaml",
            "shell",
            "text"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intro",
    "steps",
    "action_example",
    "results_intro",
    "results",
    "scope"
  ],
  "properties": {
    "intro": {
      "type": "string",
      "minLength": 1,
      "description": "Markdown (inline)"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown (inline)"
          }
        }
      }
    },
    "action_example": {
      "$ref": "#/$defs/snippet"
    },
    "results_intro": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "value"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "description": "Markdown (inline)"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "text",
        "example"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown (inline)"
        },
        "example": {
          "$ref": "#/$defs/snippet"
        }
      }
    }
  }
}
