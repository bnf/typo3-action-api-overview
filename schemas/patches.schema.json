{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patches.schema.json",
  "title": "Patch chain on Gerrit, generated by scripts/update-patches.py",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "changes"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gerrit",
        "project",
        "tip",
        "generated_by",
        "generated_at"
      ],
      "properties": {
        "gerrit": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "tip": {
          "type": "integer"
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "url",
          "subject",
          "change_id",
          "status",
          "work_in_progress",
          "patchset",
          "branch",
          "hashtags",
          "resolves",
          "related",
          "insertions",
          "deletions",
          "updated"
        ],
        "properties": {
          "number": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "change_id": {
            "type": "string",
            "pattern": "^I[0-9a-f]{40}$"
          },
          "status": {
            "enum": [
              "NEW",
              "MERGED",
              "ABANDONED"
            ]
          },
          "work_in_progress": {
            "type": "boolean"
          },
          "patchset": {
            "type": "integer"
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "hashtags": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolves": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "integer"
            }
          },
          "related": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "integer"
            }
          },
          "insertions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "updated": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
