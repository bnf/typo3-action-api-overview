{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screenshots.schema.json",
  "title": "Screenshots; personal data must be blurred before adding",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "file",
      "window",
      "title",
      "caption",
      "alt",
      "featured"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "file": {
        "type": "string",
        "pattern": "^images/.+\\.(png|jpg|webp)$"
      },
      "window": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "caption": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown (inline)"
      },
      "alt": {
        "type": "string",
        "minLength": 1
      },
      "featured": {
        "type": "boolean"
      }
    }
  }
}
