{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issues.schema.json",
  "title": "Forge issues, generated by scripts/update-issues.py",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "issues"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge",
        "epic",
        "generated_by",
        "generated_at"
      ],
      "properties": {
        "forge": {
          "type": "string",
          "minLength": 1
        },
        "epic": {
          "type": "integer"
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "url",
          "subject",
          "tracker",
          "status",
          "parent"
        ],
        "properties": {
          "number": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "tracker": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
