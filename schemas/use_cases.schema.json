{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "use_cases.schema.json",
  "title": "Use cases; status is derived from the referenced Gerrit changes",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "channel",
      "text",
      "example",
      "patches"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "channel": {
        "type": "string",
        "minLength": 1
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown (inline)"
      },
      "example": {
        "type": "string",
        "minLength": 1,
        "description": "Markdown (inline)"
      },
      "patches": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "integer"
        }
      }
    }
  }
}
