{
  "principles": [
    {
      "title": "Scopes of the app",
      "text": "An app with only `content:read` cannot call a write action, even if the user can."
    },
    {
      "title": "Permissions of the user",
      "text": "Actions run as the backend user. Page permissions, table and field access and workspaces apply as usual."
    }
  ],
  "calculator": {
    "title": "Scope calculator",
    "intro": "The scopes of an OAuth token are the intersection of the scopes that the app requests, the scopes that an administrator configured for the app and the scopes that the user can hold. Change the values and select a user.",
    "note": "In an action that the token can call, the permissions of the user still apply. On every request, EXT:hub intersects the scopes of the token with the current configuration of the app again, so when an administrator removes a scope from an app, the change applies immediately.",
    "scopes": [
      {
        "id": "content:read",
        "name": "Read access to content",
        "allowed_for": "everyone"
      },
      {
        "id": "content:write",
        "name": "Writable access to content",
        "allowed_for": "everyone"
      },
      {
        "id": "dashboard:read",
        "name": "Dashboard read access",
        "allowed_for": "dashboard_access"
      },
      {
        "id": "dashboard:write",
        "name": "Dashboard write access",
        "allowed_for": "dashboard_access"
      },
      {
        "id": "token:generate",
        "name": "Management of app tokens",
        "allowed_for": "admin"
      },
      {
        "id": "mcp",
        "name": "Model Context Protocol (MCP)",
        "allowed_for": "everyone"
      }
    ],
    "users": [
      {
        "id": "admin",
        "label": "Administrator",
        "admin": true,
        "dashboard_access": true
      },
      {
        "id": "editor",
        "label": "Editor with dashboard",
        "admin": false,
        "dashboard_access": true
      },
      {
        "id": "limited",
        "label": "Editor without dashboard",
        "admin": false,
        "dashboard_access": false
      }
    ],
    "defaults": {
      "user": "editor",
      "requested": [
        "content:read",
        "content:write",
        "dashboard:read",
        "dashboard:write",
        "mcp"
      ],
      "configured": [
        "content:read",
        "dashboard:read",
        "dashboard:write",
        "mcp"
      ]
    },
    "actions": [
      {
        "method": "GET",
        "name": "Page tree",
        "path": "/page/tree",
        "scopes": [
          "content:read"
        ]
      },
      {
        "method": "PATCH",
        "name": "Update a record",
        "path": "/records/{schema}/{identifier}",
        "scopes": [
          "content:read",
          "content:write"
        ]
      },
      {
        "method": "GET",
        "name": "Fetch dashboards",
        "path": "/dashboards",
        "scopes": [
          "dashboard:read"
        ]
      },
      {
        "method": "POST",
        "name": "Create a dashboard",
        "path": "/dashboards",
        "scopes": [
          "dashboard:read",
          "dashboard:write"
        ]
      },
      {
        "method": "POST",
        "name": "Generate an app token",
        "path": "/token/generate",
        "scopes": [
          "token:generate"
        ]
      },
      {
        "method": "POST",
        "name": "Use actions as MCP tools",
        "path": "/mcp",
        "scopes": [
          "mcp"
        ]
      }
    ]
  },
