{
  "principles": [
    {
      "title": "Scopes decide which actions an app may call",
      "text": "An app with only `content:read` cannot call a write action, even if the user could."
    },
    {
      "title": "The user’s permissions decide what an action may do",
      "text": "Actions run as the backend user. Page permissions, table and field access and workspaces apply as usual."
    }
  ],
  "calculator": {
    "title": "Try it: which scopes does an OAuth app get?",
    "intro": "The scopes of an OAuth token are the intersection of what the app requests, what an administrator configured for the app and what the user may hold. Toggle the values and pick a user.",
    "note": "Within an allowed action, the user’s own permissions still apply. On every request, the token’s scopes are intersected with the app’s current configuration again, so removing a scope from an app takes effect immediately.",
    "scopes": [
      {
        "id": "content:read",
        "name": "Read access to content",
        "allowed_for": "everyone"
      },
      {
        "id": "content:write",
        "name": "Writable access to content",
        "allowed_for": "everyone"
      },
      {
        "id": "dashboard:read",
        "name": "Dashboard read access",
        "allowed_for": "dashboard_access"
      },
      {
        "id": "dashboard:write",
        "name": "Dashboard write access",
        "allowed_for": "dashboard_access"
      },
      {
        "id": "token:generate",
        "name": "Management of app tokens",
        "allowed_for": "admin"
      },
      {
        "id": "mcp",
        "name": "Model Context Protocol (MCP)",
        "allowed_for": "everyone"
      }
    ],
    "users": [
      {
        "id": "admin",
        "label": "Administrator",
        "admin": true,
        "dashboard_access": true
      },
      {
        "id": "editor",
        "label": "Editor with dashboard",
        "admin": false,
        "dashboard_access": true
      },
      {
        "id": "limited",
        "label": "Editor without dashboard",
        "admin": false,
        "dashboard_access": false
      }
    ],
    "defaults": {
      "user": "editor",
      "requested": [
        "content:read",
        "content:write",
        "dashboard:read",
        "dashboard:write",
        "mcp"
      ],
      "configured": [
        "content:read",
        "dashboard:read",
        "dashboard:write",
        "mcp"
      ]
    },
    "actions": [
      {
        "method": "GET",
        "name": "Page tree",
        "path": "/page/tree",
        "scopes": [
          "content:read"
        ]
      },
      {
        "method": "PATCH",
        "name": "Update a record",
        "path": "/records/{schema}/{identifier}",
        "scopes": [
          "content:read",
          "content:write"
        ]
      },
      {
        "method": "GET",
        "name": "Fetch dashboards",
        "path": "/dashboards",
        "scopes": [
          "dashboard:read"
        ]
      },
      {
        "method": "POST",
        "name": "Create a dashboard",
        "path": "/dashboards",
        "scopes": [
          "dashboard:read",
          "dashboard:write"
        ]
      },
      {
        "method": "POST",
        "name": "Generate an app token",
        "path": "/token/generate",
        "scopes": [
          "token:generate"
        ]
      },
      {
        "method": "POST",
        "name": "Use actions as MCP tools",
        "path": "/mcp",
        "scopes": [
          "mcp"
        ]
      }
    ]
  },
  "app_types": {
    "title": "Apps, tokens and consent",
    "columns": [
      "OAuth app",
